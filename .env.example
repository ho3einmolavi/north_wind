# --- App ---
NODE_ENV=development
PORT=3000

# --- Postgres ---
PGHOST=postgres
PGPORT=5432
PGUSER=northwind
PGPASSWORD=northwind
PGDATABASE=northwind

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Mock payment provider ---
PAYMENT_PROVIDER_URL=http://mock-provider:4000
# HMAC secret the mock provider uses to sign POST /webhooks/payment
PAYMENT_WEBHOOK_SECRET=whsec_nw_local_dev_2f9c1a7b

# --- Auth ---
JWT_SECRET=dev_jwt_secret_change_me
# simulated cross-service latency (ms) for the auth lookup
AUTH_LOOKUP_DELAY_MS=40

# --- Feature flags ---
ATTENDEE_COUNT_WORKER_ENABLED=true
# set to "false" to instantly roll back the webhook settlement fix
WEBHOOK_SETTLEMENT_FIX_ENABLED=true
